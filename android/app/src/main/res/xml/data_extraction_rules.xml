<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 备份闹钟配置与路由器地址（DataStore 位于 files/datastore 目录） -->
        <include
            domain="file"
            path="datastore" />
    </cloud-backup>
    <device-transfer>
        <include
            domain="file"
            path="datastore" />
    </device-transfer>
</data-extraction-rules>
